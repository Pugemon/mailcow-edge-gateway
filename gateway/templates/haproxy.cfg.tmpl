# /etc/haproxy/haproxy.cfg — вход почтовых портов для mailcow, стоящего за NAT.
# Файл создаётся gateway/install.sh из gateway/templates/haproxy.cfg.tmpl и gateway.conf;
# ручные правки будут перезаписаны при следующем запуске — меняйте шаблон или настройки.
#
# Чистый TCP-проброс: TLS (STARTTLS и неявный TLS) терминирует сам mailcow, реальный IP клиента
# передаётся заголовком PROXY v2 на haproxy-listeners mailcow через оверлейную сеть.
# Health check не используется: сервер один, а проверка без PROXY-заголовка давала бы только
# ошибки в логах mailcow.

global
    log /dev/log local0
    chroot /var/lib/haproxy
    stats socket /run/haproxy/admin.sock mode 660 level admin
    user haproxy
    group haproxy
    daemon
    maxconn {{HAPROXY_MAXCONN}}

defaults
    mode tcp
    log global
    option tcplog
    timeout connect {{HAPROXY_TIMEOUT_CONNECT}}
    timeout client {{HAPROXY_TIMEOUT}}
    timeout server {{HAPROXY_TIMEOUT}}

# На каждом входе отклоняются источники из частных и служебных сетей (/etc/haproxy/deny-src.lst).
# Адрес из PROXY-заголовка mailcow считает адресом клиента, а 127.0.0.1 и подсеть контейнеров
# mailcow (172.22.1.0/24 по умолчанию) входят в его mynetworks — такой клиент получил бы open relay.
#
# IMAP: клиенты держат IDLE до 29 минут, поэтому таймауты у imap/imaps больше общих.
{{LISTENERS}}
